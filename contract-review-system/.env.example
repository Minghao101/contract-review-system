# LLM配置
LLM_PROVIDER=mimo
LLM_MODEL=mimo-7b
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.mimo.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=contract_regulations
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 日志配置
LOG_LEVEL=INFO
